generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  active
  blocked
}

enum UserStatus {
  active
  inactive
  blocked
}

enum WhatsAppConnectionStatus {
  pending
  qr_required
  connected
  disconnected
  reconnecting
  blocked
  error
}

enum ContactStatus {
  valid
  invalid
  duplicate
  blocked
}

enum CampaignStatus {
  draft
  scheduled
  running
  paused
  completed
  canceled
  failed
}

enum CampaignContactStatus {
  pending
  queued
  sending
  sent
  failed
  skipped
  canceled
}

enum MessageJobStatus {
  pending
  queued
  sending
  sent
  failed
  skipped
  canceled
}

model Company {
  id          String        @id
  name        String
  slug        String        @unique
  status      CompanyStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       User[]
  connections WhatsAppConnection[]
  lists       ContactList[]
  contacts    Contact[]
  templates   MessageTemplate[]
  campaigns   Campaign[]
  jobs        MessageJob[]
  logs        MessageLog[]
  audits      AuditLog[]

  @@index([status])
  @@index([createdAt])
}

model User {
  id        String     @id
  companyId String
  name      String
  email     String
  role      String
  status    UserStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([companyId, createdAt])
}

model WhatsAppConnection {
  id               String                  @id
  companyId        String
  name             String
  phoneNumber      String
  status           WhatsAppConnectionStatus @default(pending)
  qrCode           String?
  connectedAt      DateTime?
  lastHeartbeatAt  DateTime?
  messagesSent     Int                     @default(0)
  messagesReceived Int                     @default(0)
  totalFailures    Int                     @default(0)
  dailyLimit       Int                     @default(500)
  hourlyLimit      Int                     @default(60)
  delayMinMs       Int                     @default(12000)
  delayMaxMs       Int                     @default(45000)
  sentToday        Int                     @default(0)
  sentThisHour     Int                     @default(0)
  healthScore      Int                     @default(100)
  sessionPath      String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]
  jobs             MessageJob[]
  logs             MessageLog[]

  @@unique([companyId, phoneNumber])
  @@index([companyId, status])
  @@index([companyId, createdAt])
}

model ContactList {
  id                String   @id
  companyId         String
  name              String
  source            String
  totalContacts     Int      @default(0)
  validContacts     Int      @default(0)
  invalidContacts   Int      @default(0)
  duplicateContacts Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts          Contact[]
  campaigns         Campaign[]

  @@index([companyId, createdAt])
}

model Contact {
  id               String        @id
  companyId        String
  listId           String
  name             String
  phone            String
  rawPhone         String
  tags             Json          @default("[]")
  customFields     Json          @default("{}")
  origin           String
  status           ContactStatus @default(valid)
  validationError  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  list             ContactList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  campaignContacts CampaignContact[]
  jobs             MessageJob[]
  logs             MessageLog[]

  @@unique([companyId, listId, phone])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, listId])
}

model MessageTemplate {
  id        String   @id
  companyId String
  name      String
  body      String
  mediaUrl  String?
  variables Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model Campaign {
  id             String         @id
  companyId      String
  connectionId   String
  contactListId  String
  name           String
  message        String
  mediaUrl       String?
  status         CampaignStatus @default(draft)
  totalContacts  Int            @default(0)
  totalSent      Int            @default(0)
  totalDelivered Int            @default(0)
  totalFailures  Int            @default(0)
  totalPending   Int            @default(0)
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection     WhatsAppConnection @relation(fields: [connectionId], references: [id])
  contactList    ContactList    @relation(fields: [contactListId], references: [id])
  contacts       CampaignContact[]
  jobs           MessageJob[]
  logs           MessageLog[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, connectionId])
}

model CampaignContact {
  id                String                @id
  companyId         String
  campaignId        String
  contactId         String
  status            CampaignContactStatus @default(pending)
  providerMessageId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  campaign          Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact           Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([companyId, campaignId, contactId])
  @@index([companyId, status])
  @@index([companyId, campaignId])
  @@index([companyId, createdAt])
}

model MessageJob {
  id                String           @id
  companyId         String
  campaignId        String
  contactId         String
  connectionId      String
  message           String
  mediaUrl          String?
  attempt           Int              @default(0)
  maxAttempts       Int              @default(3)
  status            MessageJobStatus @default(pending)
  scheduledAt       DateTime
  idempotencyKey    String
  queueJobId        String
  providerMessageId String?
  error             String?
  startedAt         DateTime?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign          Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact           Contact          @relation(fields: [contactId], references: [id])
  connection        WhatsAppConnection @relation(fields: [connectionId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@index([companyId, campaignId])
  @@index([companyId, createdAt])
}

model MessageLog {
  id           String   @id
  companyId    String
  type         String
  campaignId   String?
  connectionId String?
  messageJobId String?
  contactId    String?
  message      String?
  status       String
  error        String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  connection   WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([companyId, campaignId])
  @@index([companyId, type])
  @@index([companyId, createdAt])
}

model AuditLog {
  id         String   @id
  companyId  String
  actorId    String?
  action     String
  entityType String   @default("attozap")
  entityId   String?
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}
